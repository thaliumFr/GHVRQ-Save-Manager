<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             xmlns:models="clr-namespace:GHVRQ_Save_Manager.Data"
             xmlns:components="clr-namespace:GHVRQ_Save_Manager.Components"
             x:Class="GHVRQ_Save_Manager.Pages.ItemsPage">
    <VerticalStackLayout VerticalOptions="Fill" >
        <Label Text="items Tab"  x:Name="ItemsLabel"/>
        <SearchBar Placeholder="Search" x:Name="ItemSearchBar" SearchButtonPressed="ItemSearchBar_Search"/>


        <CollectionView x:Name="ItemsCollectionView" VerticalOptions="Fill" VerticalScrollBarVisibility="Always" HorizontalOptions="Fill" Margin="0, 10, 20, 0" SelectionMode="None" >
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:GHVRObject">
                    <components:ItemCardComponent Item="{Binding}"></components:ItemCardComponent>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentView>
