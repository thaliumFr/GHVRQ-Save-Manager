<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"     
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             x:Class="GHVRQ_Save_Manager.Components.Vector3Component"
             xmlns:data="clr-namespace:GHVRQ_Save_Manager.Data"
             x:Name="Vector3"
             x:DataType="data:Vector3Data">
    <VerticalStackLayout>
        <material:TextField Title="x" ReturnCommandParameter="x" Loaded="AddFieldToList"></material:TextField>
        <material:TextField Title="y" ReturnCommandParameter="y" Loaded="AddFieldToList"></material:TextField>
        <material:TextField Title="z" ReturnCommandParameter="z" Loaded="AddFieldToList"></material:TextField>
    </VerticalStackLayout>
</ContentView>
