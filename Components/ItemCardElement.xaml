<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GHVRQ_Save_Manager.Components.ItemCardComponent"          
             xmlns:fa="clr-namespace:UraniumUI.Icons.FontAwesome;assembly=UraniumUI.Icons.FontAwesome"   
             xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
             x:Name="ItemCard">
    <Border Stroke="{DynamicResource Text}" StrokeShape="RoundRectangle 5" Padding="10" HorizontalOptions="Fill" VerticalOptions="Fill">
        <Grid RowDefinitions="*, *, *" ColumnDefinitions="*, *" HorizontalOptions="Fill" VerticalOptions="Fill">
            <Label Grid.Row="0" Grid.Column="0">Item Name</Label>
            <Label Grid.Row="0" Grid.Column="1">Item UUID</Label>

            <Label Grid.Row="1" Grid.Column="0" Text="{Binding Source={x:Reference ItemCard}, Path=ItemID}" FontAttributes="Bold" />
            <Label Grid.Row="1" Grid.Column="1" Text="{Binding Source={x:Reference ItemCard}, Path=ItemUUID}" FontAttributes="Bold" />
            <Button Grid.Row="2" Grid.Column="1" Text="Add to backpack" ImageSource="backpack_icon.png" HorizontalOptions="End" CommandParameter="{Binding Source={x:Reference ItemCard}, Path=ItemUUID}" Clicked="Button_Clicked"/>
        </Grid>
    </Border>
</ContentView>
