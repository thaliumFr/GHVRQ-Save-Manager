<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="GHVRQ_Save_Manager.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:GHVRQ_Save_Manager"
    Title="GHVRQ_Save_Manager">

    <TabBar>
        <Tab Title="Main">
            <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />
        </Tab>
        <Tab Title="Player Stats">
            <ShellContent
            Title="Player Stats"
            ContentTemplate="{DataTemplate local:PlayerStatPage}"
            Route="PlayerStatPage" />
        </Tab>
    </TabBar>

</Shell>
